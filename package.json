{
  "name": "mx-cad",
  "version": "0.1.0",
  "private": true,
  "description": "Visor local de planos DWG y DXF",
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "assets": "node scripts/copy-assets.mjs",
    "dev": "npm run assets && vite --host 127.0.0.1",
    "build": "npm run assets && tsc --noEmit && vite build",
    "start": "npm run build && electron .",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs"
  },
  "dependencies": { "@flyfish-dev/cad-viewer": "0.8.3" },
  "devDependencies": { "electron": "^42.0.0", "vite": "^7.0.0", "typescript": "^5.9.0", "@playwright/test": "^1.56.0" }
}
