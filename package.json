    "preview": "vite preview --host 127.0.0.1",
    "test": "node scripts/test-suite.mjs"
  },
  "dependencies": {
    "@flyfish-dev/cad-viewer": "0.8.3",
    "node-unrar-js": "2.0.2",
    "three": "0.180.0",
    "web-ifc": "0.0.72"
  },
  "devDependencies": {
    "electron": "^42.0.0",
    "vite": "^7.0.0",
    "typescript": "^5.9.0",
    "@playwright/test": "^1.56.0"
  }
}
